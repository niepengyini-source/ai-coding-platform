# Copy to .env. Keep .env private; no real research data belongs in Git.
PLATFORM_DEBUG=0
# Allow members to create their own accounts. Set 0 to hide/disable registration.
PLATFORM_ALLOW_REGISTRATION=1
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8000
PLATFORM_ALLOWED_HOSTS=localhost,127.0.0.1
# For LAN: set PLATFORM_HOST to your specific LAN IP, and add that IP above.
# PostgreSQL is optional. Without DATABASE_URL the local SQLite database is used.
# DATABASE_URL=postgresql://platform:CHANGE_ME@127.0.0.1:5432/platform
# Only enable these when a trusted HTTPS reverse proxy is configured.
PLATFORM_HTTPS=0
# PLATFORM_SECRET_KEY=generate-a-long-random-secret-and-never-upload-it
